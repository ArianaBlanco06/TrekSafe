[Unit]
Description=TrekSafe R2 API y HTTPS, imagen fijada por digest
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/treksafe/deployment/oci
ExecStartPre=/bin/bash /opt/treksafe/deployment/oci/preflight.sh api
ExecStart=/usr/bin/docker compose --project-name treksafe-api --env-file /etc/treksafe/deployment.env -f /opt/treksafe/deployment/oci/compose.api.yml up -d --no-build --pull never
ExecStop=/usr/bin/docker compose --project-name treksafe-api --env-file /etc/treksafe/deployment.env -f /opt/treksafe/deployment/oci/compose.api.yml stop --timeout 45
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
