# Copiar a /etc/treksafe/deployment.env. No contiene secretos.
# Valores vacíos hacen fallar el preflight; no hay recursos o URLs supuestos.
# Formato literal CLAVE=valor, sin comillas ni sustitución de shell.
TREKSAFE_IMAGE=
CADDY_IMAGE=
DEPLOYMENT_COMMIT=
SCHEMA_VERSION=032
API_HOST=
ACME_EMAIL=
# Solo true tras revisar etiquetas/cuotas/costo cero en la consola OCI real.
OCI_ALWAYS_FREE_CONFIRMED=false
