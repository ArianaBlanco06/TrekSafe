# Copiar a /etc/treksafe/worker.env: root:root, modo 600. No añadir comillas.
NODE_ENV=production
PORT=3000
API_PREFIX=/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=24h
MEDICAL_ENCRYPTION_KEY=
CRON_ENABLED=true
CRON_INTERVAL_MS=60000
OUTBOX_INTERVAL_MS=15000
OUTBOX_BATCH_SIZE=1
WORKER_HEARTBEAT_MAX_AGE_MS=180000
OUTBOX_PENDING_MAX_AGE_MS=600000
CORS_ORIGIN=
PUBLIC_APP_URL=
MAIL_DEV_FALLBACK=false
BREVO_API_KEY=
# Remitente real verificado de Brevo, no una dirección inventada.
SMTP_FROM=
