{
  "name": "@treksafe/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:equipo": "tsx --tsconfig tsconfig.json --test src/**/*.test.ts src/**/*.test.tsx",
    "test:pwa:privacidad": "playwright test --config playwright.privacy.config.ts",
    "test:hu28:dev": "playwright test --config playwright.hu28-dev.config.ts",
    "test:ui": "playwright test",
    "typecheck:ui": "tsc --noEmit -p tsconfig.playwright.json"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
